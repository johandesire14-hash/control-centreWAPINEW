# WapiGarage — modèle de configuration
# Copiez les noms dans Replit > Secrets, mais ne mettez jamais de vraies clés dans GitHub.

# API / sessions
PORT=3000
SESSION_SECRET=remplacer-par-une-valeur-generee-avec-openssl-rand-hex-32

# Base Supabase PostgreSQL — secret, uniquement côté API
SUPABASE_DATABASE_URL=postgresql://...
SUPABASE_SERVICE_ROLE_KEY=remplacer-par-la-cle-service-role

# Supabase côté application mobile — la clé anon est publique mais doit être celle du bon projet
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=remplacer-par-la-cle-anon

# Adresse publique de l'API, sans https://
EXPO_PUBLIC_API_DOMAIN=api.votre-domaine.com

# Authentification Google — uniquement côté API
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Paiement KPay — uniquement côté API
KPAY_API_URL=https://admin.kpay.site
KPAY_API_KEY=...
KPAY_SECRET_KEY=...
KPAY_WEBHOOK_SECRET=...

# Optionnel : liste des redirections OAuth mobiles autorisées
MOBILE_AUTH_REDIRECT_ALLOWLIST=wapigarage://auth-callback

# Optionnel : chemin de déploiement web/mobile
BASE_PATH=/
